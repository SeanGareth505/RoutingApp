{
  "name": "route-planner",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:web": "ng serve --port 4301 --proxy-config proxy.conf.json",
    "start:api": "node server/src/index.js",
    "build": "ng build",
    "build:gh-pages": "ng build --configuration production --base-href ./",
    "deploy:gh-pages": "npm run build:gh-pages && npx angular-cli-ghpages --dir=dist/route-planner",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "^21.2.6",
    "@angular/cdk": "^21.2.4",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@bluehalo/ngx-leaflet": "^21.0.0",
    "@geoman-io/leaflet-geoman-free": "^2.19.2",
    "@mapbox/polyline": "^1.2.1",
    "@primeuix/themes": "^2.0.3",
    "@types/leaflet": "^1.9.21",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "papaparse": "^5.5.3",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.0",
    "@types/papaparse": "^5.5.2",
    "angular-cli-ghpages": "^3.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
